OFFERPILOT_APP_NAME=OfferPilot API
OFFERPILOT_ENVIRONMENT=development

# By default, SQLite is stored at backend/data/offerpilot.db.
# Override only when needed, for example:
# OFFERPILOT_DATABASE_URL=sqlite:///./data/offerpilot.db

# PDF originals are stored locally here during Phase 1-2.
# OFFERPILOT_UPLOAD_DIR=D:/agent 项目/OfferPilot/backend/uploads

# S1-1 server sessions: non-development always requires Secure/HTTPS cookies.
OFFERPILOT_SESSION_TTL_SECONDS=43200
# Development-only override; non-development cannot disable Secure.
# OFFERPILOT_SESSION_COOKIE_SECURE=false
# JSON array; configure the exact browser origins when adding a frontend.
OFFERPILOT_TRUSTED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
OFFERPILOT_AUTH_ATTEMPT_WINDOW_SECONDS=900
OFFERPILOT_AUTH_LOGIN_ATTEMPT_LIMIT=5
OFFERPILOT_AUTH_IP_ATTEMPT_LIMIT=30
OFFERPILOT_AUTH_REGISTRATION_ATTEMPT_LIMIT=10
